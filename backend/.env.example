# Copy to .env and fill in. For Railway, set these as environment variables
# (never commit a real .env file).
PORT=3000
NODE_ENV=production
JWT_SECRET=change-this-to-a-random-secret-string

# Hosted database (Neon / Supabase / Render Postgres).
# When DATABASE_URL is set, the app uses Postgres (persistent across restarts).
# When unset, it falls back to a local file database (backend/eden.db) — fine for dev.
# Example: postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Hubtel payments — leave empty to keep DEMO_MODE (simulated payments + console SMS).
# When you have real credentials, fill these in and set DEMO_MODE=false in backend/server.js
HUBTEL_MERCHANT_ACCOUNT=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=EdenTree

# Email notifications (optional). When SMTP_HOST + SMTP_FROM + NOTIFY_EMAIL are set,
# the shop receives an email for each new order and payment confirmation.
# Leave blank to skip email entirely.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Eden Tree <no-reply@edentreegh.com>
NOTIFY_EMAIL=orders@edentreegh.com
